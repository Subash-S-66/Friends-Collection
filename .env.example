# ==========================================
# Friends Collections - Environment Variables
# ==========================================

# -----------------
# Server Configuration (Backend)
# -----------------
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas URI for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/friends_collections?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Initial Admin Credentials
ADMIN_EMAIL=friends.collection06@gmail.com
ADMIN_PASSWORD=YourSecureAdminPasswordHere

# Frontend URL (CORS configuration for server)
CLIENT_URL=https://your-friends-collection.vercel.app

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
ORDER_RATE_LIMIT_MAX=20

# Business Details
BUSINESS_NAME=Friends Collections
BUSINESS_PHONE=9500757024
BUSINESS_EMAIL=friends.collection06@gmail.com
BUSINESS_ADDRESS=7/4 Perambur High Road, 1st Cross St, Jamalia, Chennai - 12
BUSINESS_INSTAGRAM=friends_collection_in

# Cloudinary Storage (optional for cloud product image hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=friends_collections/products

# -----------------
# Client Configuration (Frontend - Vercel)
# -----------------
# Set this in Vercel project environment settings:
VITE_API_URL=https://your-backend-api.onrender.com/api
