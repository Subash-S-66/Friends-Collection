# ==========================================
# Friends Collections - Environment Variables Template
# Copy this file to .env (or configure in Render / Vercel dashboard)
# ==========================================

# -----------------
# Server Configuration (Backend)
# -----------------
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Friends_Collections?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
ADMIN_JWT_EXPIRE=1d

# Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=friends.collection06@gmail.com
ADMIN_PASSWORD=YourSecureAdminPasswordHere

# Frontend URL (CORS allowed origin for backend)
CLIENT_URL=https://friends-collection.vercel.app

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
ORDER_RATE_LIMIT_MAX=20

# Business Details
BUSINESS_NAME=Friends Collections
BUSINESS_PHONE=9500757024
BUSINESS_EMAIL=friends.collection06@gmail.com
BUSINESS_ADDRESS=7/4 Perambur High Road, 1st Cross St, Jamalia, Chennai - 12
BUSINESS_INSTAGRAM=friends_collection_in

# Cloudinary Cloud Storage (for product images & hero banners)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=friends_collections/products

# -----------------
# Email Service Configuration
# -----------------
# HTTP REST API Mail Services (Port 443 - Recommended for Render & cloud hosts that block port 25/465/587):
BREVO_API_KEY=your_brevo_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# Nodemailer / SMTP (Works on localhost or hosts with open SMTP ports):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=friends.collection06@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM="Friends Collections" <friends.collection06@gmail.com>
EMAIL_LOGO_URL=https://res.cloudinary.com/<cloud_name>/image/upload/w_200,f_auto,q_auto/v1792556054/friends_collections/logo.png

# -----------------
# Google OAuth Configuration
# -----------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# -----------------
# Razorpay Payment Gateway (Test or Live)
# -----------------
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=rzp_test_or_live_key_id

# -----------------
# Client Configuration (Frontend - Vercel)
# -----------------
# Set this in Vercel project environment settings:
VITE_API_URL=https://friends-collection.onrender.com/api
